# --- LiteLLM proxy (your own, runs on this laptop: scripts/proxy.sh) ---
LLM_BASE_URL=http://127.0.0.1:4000
# any random string; the proxy and the code share it
LITELLM_MASTER_KEY=sk-local-change-me
# --- Provider keys: your PERSONAL keys only (never a company key or company proxy) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# --- Optional: Langfuse Cloud (EU) from your own free account. Empty = no tracing. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# --- Proxy model aliases (defined in litellm/config.yaml) and effort ---
WRITER_MODEL=writer
JUDGE_MODEL=judge
AGENT_MODEL=agent
